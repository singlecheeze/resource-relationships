{
  "name": "resource-relationships",
  "version": "0.5.11",
  "description": "Resource relationship explorer and YAML editor for OpenShift 4.22",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build": "NODE_ENV=production node -r ts-node/register ./node_modules/.bin/webpack",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "start": "node -r ts-node/register ./node_modules/.bin/webpack serve",
    "start-console": "./start-console.sh",
    "test:dom": "node node_modules/webpack-cli/bin/cli.js --config webpack.preview.cjs && node tests/dom.cjs"
  },
  "devDependencies": {
    "@openshift-console/dynamic-plugin-sdk": "4.22.0",
    "@openshift-console/dynamic-plugin-sdk-webpack": "4.22.0",
    "@patternfly/react-core": "6.7.0",
    "@patternfly/react-icons": "6.7.0",
    "@playwright/test": "1.64.1",
    "@swc/core": "1.16.20",
    "@testing-library/dom": "10.4.2",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "7.1.5",
    "fork-ts-checker-webpack-plugin": "9.1.0",
    "i18next": "25.10.10",
    "jsdom": "30.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "16.5.8",
    "style-loader": "4.0.0",
    "swc-loader": "0.2.7",
    "ts-node": "10.9.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "webpack": "5.112.2",
    "webpack-cli": "7.2.3",
    "webpack-dev-server": "5.2.7"
  },
  "consolePlugin": {
    "name": "resource-relationships",
    "version": "0.5.11",
    "displayName": "Resource Relationships",
    "description": "Resource relationship explorer and YAML editor for OpenShift 4.22",
    "exposedModules": {
      "RelationshipsPage": "./components/RelationshipsPage"
    },
    "dependencies": {
      "@console/pluginAPI": ">=4.22.0-0 <4.23.0-0"
    }
  },
  "dependencies": {
    "yaml": "2.9.1"
  }
}
